[Unit]
Description=AutoMind Backend API and Frontend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/automind/backend
Environment=PATH=/home/ubuntu/automind/backend/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=DATABASE_URL=sqlite:///./automind.db
Environment=CORS_ORIGINS=http://54.156.126.227:8800,http://localhost:8800
ExecStart=/home/ubuntu/automind/backend/venv/bin/python /home/ubuntu/automind/backend/deploy.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
