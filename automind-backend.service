[Unit]
Description=AutoMind Backend API
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/automind/backend
Environment=PATH=/home/ubuntu/automind/backend/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=DATABASE_URL=sqlite:///./automind.db
ExecStart=/home/ubuntu/automind/backend/venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 8800
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
